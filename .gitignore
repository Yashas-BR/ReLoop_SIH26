# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Environment files ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── SQLite database (large binary, regenerated by seed) ──────────────────────
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal

# ── Uploaded files ────────────────────────────────────────────────────────────
server/uploads/*
!server/uploads/.gitkeep

# ── Vite / build artifacts ───────────────────────────────────────────────────
client/dist/
client/.vite/

# ── OS & editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
