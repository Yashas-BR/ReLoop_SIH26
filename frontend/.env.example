# Frontend environment variables
# Copy to .env and adjust for your local setup. Vite exposes VITE_* vars to the app.

# Backend base URL. Leave unset (default '/v1') to go through the Vite dev
# proxy in vite.config.js, or set a full URL to call a backend directly.
#   VITE_API_BASE_URL=http://localhost:3000/v1
#   VITE_API_BASE_URL=http://192.168.1.10:3000/v1   (LAN — phone/emulator)
#VITE_API_BASE_URL=

# Demo identity used until real authentication is wired up.
#VITE_DEMO_COLLECTOR_ID=1
#VITE_DEMO_RECYCLER_ID=1
#VITE_DEFAULT_LOCATION=Bengaluru
#VITE_DEFAULT_LAT=12.9716
#VITE_DEFAULT_LNG=77.5946

# Vite dev-server backend target (used by vite.config.js when no proxy target is given).
VITE_DEV_SERVER_BACKEND=http://localhost:3000
