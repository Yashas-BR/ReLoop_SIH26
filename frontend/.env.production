# Production environment — set these as Environment Variables in the Netlify UI
# (Site → Site configuration → Environment variables) rather than committing
# real values here.

# Full URL of the deployed backend, e.g. Railway / Render / Fly.io
VITE_API_BASE_URL=https://your-backend.up.railway.app/v1

# Optional: override demo identities for the live demo account
# VITE_DEMO_COLLECTOR_ID=1
# VITE_DEMO_RECYCLER_ID=1
# VITE_DEFAULT_LOCATION=Bengaluru
# VITE_DEFAULT_LAT=12.9716
# VITE_DEFAULT_LNG=77.5946
