# Copy this file to .env and fill in your real values.
# Never commit the actual .env file to git.

# --- Option A: Local PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=kabadiwala_connect
PGUSER=postgres
PGPASSWORD=your_local_password

# --- Option B: Hosted (Neon / Supabase) ---
# If using a hosted connection string instead, set this and the code
# will prefer it automatically over the individual PG* vars above.
DATABASE_URL=

# Cloudinary evidence storage. Create an unsigned-free Cloudinary account,
# then copy these values from Dashboard > API Keys. Do not expose API_SECRET
# to the frontend or commit the real .env file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
